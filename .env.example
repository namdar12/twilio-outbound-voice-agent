# Twilio (buy a voice-capable number at https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# OpenAI — needs Realtime API access
OPENAI_API_KEY=your_openai_api_key

# Public base URL of this server (Twilio webhooks and media streams must reach
# it, e.g. via ngrok). No trailing slash.
BASE_URL=https://your-public-url
